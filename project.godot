config_version=5

[application]

config/name="NexVora CyberRun"
config/description="Advanced 3D Cyberpunk Parkour Game for Android"
config/version="1.0.0"
run/main_scene="res://scenes/ui/MainMenu.tscn"
config/features=PackedStringArray("4.3", "Mobile")
config/icon="res://assets/ui/icon.png"

[autoload]

GameManager="*res://scripts/managers/GameManager.gd"
AudioManager="*res://scripts/managers/AudioManager.gd"
SaveManager="*res://scripts/managers/SaveManager.gd"
InputManager="*res://scripts/managers/InputManager.gd"

[display]

